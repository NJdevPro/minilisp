(define input 
        '(3   4
4   3
2   5
1   3
3   9
3   3))

; for map, reduce, quicksort
(load "examples/library.lisp")

(defun null?(x) (eq () x))
(defun cadr(lst) (car (cdr lst)))
(defun cddr(lst) (cdr (cdr lst)))

(defun transpose (lst)
  (if (null? lst)
      (list '() '())
      (let result (transpose (cddr lst))
        (list
          (cons (car lst) (car result))
          (cons (cadr lst) (cadr result))))
  ))

(defun abs(x)
    (if (< x 0) (- 0 x) x))

(defun map2 (fn lst1 lst2)
  (if (or (null? lst1) (null? lst2))
      ()
      (cons (fn (car lst1) (car lst2))
            (map2 fn (cdr lst1) (cdr lst2)))))

; Now we can write our complete solution:
(defun sum-of-differences (columns)
  (reduce +
          (map (map2 - (sort (car columns)) (sort (cadr columns))) abs)
          0))

(define columns (transpose input))
(println (sum-of-differences columns))

; Part 2
(defun unique-elements (list2 list1)
  (if (eq () list2)
      ()
      (if (member list1 (car list2))
          (unique-elements (cdr list2) list1)
          (cons (car list2) 
                (unique-elements (cdr list2) list1)))))

(define sum (reduce + (cadr columns) 0))
(define uniques (unique-elements (cadr columns)(car columns)))
(println uniques)
(println (- sum (reduce + uniques 0)))